<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Jarvis daemon LaunchAgent (Phase 2E).

  Generated from this template by scripts/install_launch_agent.sh.
  The script substitutes the four __PLACEHOLDER__ tokens with
  absolute paths derived from the invoking shell + the user's
  ~/.local/share/jarvis layout. The Anthropic API key is NEVER
  written into this file — the wrapper at __WRAPPER_PATH__ pulls
  it from the macOS keychain (item: jarvis-anthropic) at boot.
  This is what makes ``launchctl print`` safe to share.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.jarvis.daemon</string>

  <key>ProgramArguments</key>
  <array>
    <string>__WRAPPER_PATH__</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__JARVIS_REPO__</string>

  <!--
    Run at user login. KeepAlive is false so a clean shutdown (user
    logout, manual ``launchctl unload``) doesn't cause launchd to
    immediately respawn the process — that would defeat the
    uninstall script and trap the user in a loop if they hit a bug.
  -->
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <false/>

  <!--
    Process priority. Jarvis is interactive (mic loop + TTS) so it
    needs background priority but NOT the low-priority "Adaptive"
    class — that would throttle Whisper transcription on M-series.
    Inherit the default UI session priority.
  -->
  <key>ProcessType</key>
  <string>Interactive</string>

  <!--
    Standard out / err go under ~/Library/Logs/Jarvis. That folder
    already exists (the desktop crash handler writes its
    .crash_marker there), so we share it.
  -->
  <key>StandardOutPath</key>
  <string>__LOG_DIR__/stdout.log</string>
  <key>StandardErrorPath</key>
  <string>__LOG_DIR__/stderr.log</string>

  <!--
    PATH for the wrapper. macOS launchd resets PATH to a minimal
    set; the wrapper itself doesn't strictly need this (it calls
    ``security`` by absolute /usr/bin path) but it doesn't hurt
    and surfaces nicely when a user wants to debug the launch via
    ``launchctl print``.
  -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/bin:/bin:/usr/sbin:/sbin:/usr/local/bin</string>
    <key>HOME</key>
    <string>/Users/__USER__</string>
    <key>USER</key>
    <string>__USER__</string>
  </dict>
</dict>
</plist>
